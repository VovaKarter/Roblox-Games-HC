local WebHookServ = loadstring(game:HttpGet('https://raw.githubusercontent.com/VovaKarter/Roblox-Games-HC/refs/heads/main/Webhook%20service'))()
local TeleportService = game:GetService('TeleportService')
local HttpService = game:GetService('HttpService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local Players = game:GetService('Players')
local LocalPlayer = Players.LocalPlayer
local CoreGui = game:GetService('CoreGui')

local placeId = game.PlaceId
local isKicked = false

local fields = {
	{
		['name'] = "Time:",
		['value'] = os.date("*t")["hour"]..":"..os.date("*t")["min"]..":"..os.date("*t")["sec"],
		['inline'] = true
	}
}

local BorderColor = tonumber(0xcf1818)
local WebHookImage = ""
local SendTries = 0

local function MakeDataStr(time)
	local hours = time["hour"]
	local mins = time["min"]
	local sec = time["sec"]

	if #tostring(hours) == 1 then
		hours = "0"..hours
	end
	if #tostring(mins) == 1 then
		mins = "0"..mins
	end
	if #tostring(sec) == 1 then
		sec = "0"..sec
	end
	return hours..":"..mins..":"..sec
end

local function SendWebHook(msg)
    fields[1].value = MakeDataStr(os.date("*t"))
    WebHookServ.SendMessage(msg, fields, {url = WebHookImage, bordercolor = BorderColor})
end

local function teleportToBackup()
    if isKicked then return end
    isKicked = true

    SendTries += 1

    BorderColor = tonumber(0xcf1818)
    SendWebHook("Session for "..LocalPlayer.Name.." has finished")

    local succ = pcall(TeleportService:Teleport(placeId))

    if succ then
        BorderColor = tonumber(0x40e916)
        SendWebHook("Successfully reconnected after "..SendTries.." retry")
    else
        BorderColor = tonumber(0xcf1818)
        SendWebHook("Error: can't reconnect (retry: "..SendTries..")")
    end
    
    repeat 
        wait(1)
        SendTries += 1
        SendWebHook("Error: can't reconnect (retry: "..SendTries..")")
        succ = pcall(TeleportService:Teleport(placeId))
    until succ

    BorderColor = tonumber(0x40e916)
    SendWebHook("Successfully reconnected after "..SendTries.." retry")
end

repeat task.wait() until CoreGui:FindFirstChild('RobloxPromptGui')
local promptOverlay = CoreGui.RobloxPromptGui.promptOverlay

promptOverlay.ChildAdded:Connect(function(Child)
    if Child.Name == 'ErrorPrompt' and not isKicked then
        teleportToBackup()
    end
end)

if #game.Players:GetChildren() <= 1 then
    teleportToBackup()
end

game.Players.PlayerRemoving:Connect(function()
    if #game.Players:GetChildren() <= 1 then
        teleportToBackup()
    end
end)

local Sc = Instance.new("ScreenGui", CoreGui)
local Button = Instance.new("TextButton", Sc)
Button.Size = UDim2.new(.3, 0, .3, 0)
Button.BackgroundTransparency = .5
Button.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
Button.Text = "Rejoin button"

Button.MouseButton1Click:Connect(function()
    print("Teleport started")
    teleportToBackup()
end)

task.spawn(function()
    while not isKicked do
        if not LocalPlayer:IsDescendantOf(game) then
            teleportToBackup()
            break
        end
        task.wait(1)
    end
end)
