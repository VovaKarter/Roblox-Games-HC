				if v.Name ~= "CoinContainer" and v.Name ~= "NewPart" then
					v:Destroy()
				end
			end
		end
	end

	local function MakeDataStr(time)
		local hours = time["hour"]
		local mins = time["min"]
		local sec = time["sec"]

		if #tostring(hours) == 1 then
			hours = "0"..hours
		end
		if #tostring(mins) == 1 then
			mins = "0"..mins
		end
		if #tostring(sec) == 1 then
			sec = "0"..sec
		end
		return hours..":"..mins..":"..sec
	end

	local function StartTracker()
		if not AutoFarm then return end
		local cor = coroutine.create(function()
