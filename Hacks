					TotalH += 1
					fields[1].value = MoneyDiff
					fields[2].value = Farmed
					fields[3].value = Farmed//TotalH
					fields[4].value = PlrMoney
					fields[5].value = MakeDataStr(os.date("*t"))
					WebHookServ.SendMessage("Hourly report for "..plrName, fields, {url = WebHookImage, bordercolor = BorderColor})
				end
			end
		end)

		coroutine.resume(cor)
	end

